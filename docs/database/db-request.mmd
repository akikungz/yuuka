---
title: Request & Workflow Domain
config:
  layout: elk
  theme: neutral
---
erDiagram

  PLATFORM_USER {
    int    id   PK
    string role "ADMIN | INSTRUCTOR | STUDENT"
  }

  COURSE_OFFERING {
    int id PK
  }

  SEMESTER {
    int id PK
  }

  PVE_TEMPLATE {
    int    id   PK
    string name
  }

  INSTANCE {
    int    id     PK
    string status
  }

  REQUEST {
    int      id               PK
    string   title
    string   description
    int      courseOfferingId FK
    int      pveTemplateId    FK
    int      cpus
    int      memoryMB
    int      diskGB
    int      requesterId      FK
    int      reviewerId       FK "nullable"
    string   status           "PENDING | APPROVED | REJECTED | CANCELLED"
    string   reason
    datetime createdAt
    datetime updatedAt
  }

  EXTENDED_REQUEST {
    int      id               PK
    string   title
    string   description
    int      targetInstanceId FK
    int      nextSemesterId   FK
    int      requesterId      FK
    int      reviewerId       FK "nullable"
    string   status           "PENDING | APPROVED | REJECTED | CANCELLED"
    string   reason
    datetime createdAt
    datetime updatedAt
  }

  REQUEST_AUDIT_LOG {
    int      id            PK
    int      requestId     FK
    string   action        "ApprovalStatus"
    int      performedById FK
    datetime timestamp
    string   notes
  }

  EXTENDED_REQUEST_AUDIT_LOG {
    int      id                PK
    int      extendedRequestId FK
    string   action            "ApprovalStatus"
    int      performedById     FK
    datetime timestamp
    string   notes
  }

  PLATFORM_SSH_KEY {
    int      id        PK
    string   name
    string   publicKey
    int      ownerId   FK
    datetime createdAt
    datetime updatedAt
  }

  COURSE_OFFERING  ||--o{ REQUEST                    : "for"
  PVE_TEMPLATE     ||--o{ REQUEST                    : "uses"
  PLATFORM_USER    ||--o{ REQUEST                    : "requester"
  PLATFORM_USER    |o--o{ REQUEST                    : "reviewer"
  REQUEST          |o--o| INSTANCE                   : "creates"
  REQUEST          ||--o{ REQUEST_AUDIT_LOG           : "audited by"
  PLATFORM_USER    ||--o{ REQUEST_AUDIT_LOG           : "performed by"

  INSTANCE         ||--o{ EXTENDED_REQUEST            : "extended via"
  SEMESTER         ||--o{ EXTENDED_REQUEST            : "extends to"
  PLATFORM_USER    ||--o{ EXTENDED_REQUEST            : "requester"
  PLATFORM_USER    |o--o{ EXTENDED_REQUEST            : "reviewer"
  EXTENDED_REQUEST ||--o{ EXTENDED_REQUEST_AUDIT_LOG  : "audited by"
  PLATFORM_USER    ||--o{ EXTENDED_REQUEST_AUDIT_LOG  : "performed by"

  PLATFORM_USER    ||--o{ PLATFORM_SSH_KEY            : "owns"
