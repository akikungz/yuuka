# Nginx configuration for fitm.cloud
server {
    listen 80;
    server_name fitm.cloud dev.fitm.cloud grafana.fitm.cloud influxdb.fitm.cloud rustfs.fitm.cloud rustfs-console.fitm.cloud;

    location / {
        # Redirect all HTTP requests to HTTPS
        return 301 https://$host$request_uri;
    }
}

# With SSL configuration
server {
    listen 443 ssl;
    server_name fitm.cloud dev.fitm.cloud grafana.fitm.cloud influxdb.fitm.cloud rustfs.fitm.cloud rustfs-console.fitm.cloud;
    client_max_body_size 0;

    ssl_certificate /etc/ssl/certs/fitm.cloud.crt;
    ssl_certificate_key /etc/ssl/private/fitm.cloud.key;

    add_header Strict-Transport-Security "max-age=2592000; includeSubDomains; preload";

    location / {
        proxy_pass https://10.20.30.21:443; # Kubernetes Ingress Controller IP

        # Critical headers for OAuth2
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # For WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}